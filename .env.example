# ---------------------------------------------------------------------------
# Yönetim paneli (/admin)
# ---------------------------------------------------------------------------
# Üçü de tanımlı değilse panel giriş ekranı "yapılandırılmamış" uyarısı gösterir.
# Şifre özetini ve oturum anahtarını üretmek için:
#   npm run admin:hash -- "en-az-12-karakterli-güçlü-şifre"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# En az 32 karakter, rastgele. Oturum imzası VE e-posta şifresinin şifrelenmesi
# için kullanılır; değiştirilirse oturumlar kapanır ve e-posta şifresi yeniden girilir.
ADMIN_SESSION_SECRET=

# Panel içeriği, ayarlar, yedekler ve yüklenen görsellerin klasörü.
# Varsayılan: <proje>/storage. Deploy'larda korunacak kalıcı bir yol verin.
# CONTENT_DIR=/var/lib/dogumpaketi

# ---------------------------------------------------------------------------
# İletişim formu teslimatı
# ---------------------------------------------------------------------------
# E-posta ayarları PANELDEN yönetilir: /admin/eposta
#   Sunucu   : mail.tusahastanesi.com   (TUSA Hastanesi Exchange)
#   Port     : 587 + STARTTLS zorunlu
#   Kullanıcı: kullanici@gisbirhastanesi.local  (Active Directory alan adı)
#   Gönderen : info@tusahastanesi.com          (posta alan adı)
# Şifre panelde şifrelenerek storage/settings.json içine yazılır.
# Doğrulamak için: npm run mail:test -- hedef@ornek.com

# Panelde şifre girilmediyse yedek olarak kullanılır (isteğe bağlı):
# SMTP_PASS=

# Alternatif: e-posta yerine CRM / otomasyon webhook'u (JSON POST)
LEAD_WEBHOOK_URL=

# npm run mail:test çıktısında SMTP trafiğini göster
# SMTP_DEBUG=1

# ---------------------------------------------------------------------------
# Hekim verisi doğrulaması
# ---------------------------------------------------------------------------
# Hekim adları build/ISR sırasında tusahastanesi.com resmi profillerinden
# doğrulanır. Ağ erişimi olmayan CI ortamlarında "0" yaparak kapatabilirsiniz.
# DOCTOR_SOURCE_SYNC=0
